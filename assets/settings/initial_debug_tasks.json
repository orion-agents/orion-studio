// Some example tasks for common languages.
//
// For more documentation on how to configure debug tasks,
// see: https://github.com/orion-agents/orion-studio/blob/main/docs/src/debugger.md
[
  {
    "label": "Debug active Python file",
    "adapter": "Debugpy",
    "program": "$ORION_STUDIO_FILE",
    "request": "launch",
    "cwd": "$ORION_STUDIO_WORKTREE_ROOT",
  },
  {
    "label": "Debug active JavaScript file",
    "adapter": "JavaScript",
    "program": "$ORION_STUDIO_FILE",
    "request": "launch",
    "cwd": "$ORION_STUDIO_WORKTREE_ROOT",
    "type": "pwa-node",
  },
  {
    "label": "JavaScript debug terminal",
    "adapter": "JavaScript",
    "request": "launch",
    "cwd": "$ORION_STUDIO_WORKTREE_ROOT",
    "console": "integratedTerminal",
    "type": "pwa-node",
  },
]
