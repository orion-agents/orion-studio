name: orion-studio
title: Orion Studio
base: core24
version: "$RELEASE_VERSION"
summary: The editor for what's next
description: |
  Orion Studio is a modern open-source code editor, built from the ground up in Rust with
  a GPU-accelerated renderer. We help you build software faster than ever before.
grade: stable
confinement: classic
compression: lzo
platforms:
  amd64:
website: https://github.com/orion-agents/orion-studio
source-code: https://github.com/orion-agents/orion-studio
issues: https://github.com/orion-agents/orion-studio/issues
contact: https://github.com/orion-agents/orion-studio/issues

parts:
  orion-studio:
    plugin: dump
    source: "https://github.com/orion-agents/orion-studio/releases/download/v$RELEASE_VERSION/orion-studio-linux-x86_64.tar.gz"

    organize:
      # These renames seem to not be necessary, but it's tidier.
      bin: usr/bin
      libexec: usr/libexec

    stage-packages:
      - libasound2t64
      # snapcraft has a lint that this is unused, but without it Orion Studio exits with
      # "Missing Vulkan entry points: LibraryLoadFailure" in wgpu.
      - libvulkan1
      # snapcraft has a lint that this is unused, but without it Orion Studio exits with
      # "NoWaylandLib" when run with Wayland.
      - libwayland-client0
      - libxcb1
      - libxkbcommon-x11-0
      - libxkbcommon0

    build-attributes:
      - enable-patchelf

    prime:
      # Omit unneeded files from the tarball
      - -lib
      - -licenses.md
      - -share

      # Omit unneeded files from stage-packages
      - -etc
      - -usr/share/doc
      - -usr/share/lintian
      - -usr/share/man

apps:
  orion-studio:
    command: usr/bin/orion-studio
    common-id: com.orion.OrionStudio
    environment:
      ORION_STUDIO_BUNDLE_TYPE: snap
      # Compatibility until runtime bundle diagnostics consume the Orion variable.
      ZED_BUNDLE_TYPE: snap
