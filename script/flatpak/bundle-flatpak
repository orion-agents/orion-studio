#!/usr/bin/env bash

set -euo pipefail
cd "$(dirname "$0")/../.."
shopt -s extglob

script/bundle-linux --flatpak
archive="orion-studio-linux-$(uname -m).tar.gz"
if [[ ! -f "target/release/${archive}" ]]; then
    echo "Missing Orion Studio Linux archive: target/release/${archive}" >&2
    exit 1
fi
channel=$(<crates/zed/RELEASE_CHANNEL)

export CHANNEL="$channel"
export ARCHIVE="$archive"
if [[ "$channel" == "dev" ]]; then
    export APP_ID="com.orion.OrionStudio.Dev"
    export APP_NAME="Orion Studio Devel"
    export BRANDING_LIGHT="#99c1f1"
    export BRANDING_DARK="#1a5fb4"
    export ICON_FILE="app-icon-dev"
elif [[ "$channel" == "nightly" ]]; then
    export APP_ID="com.orion.OrionStudio.Nightly"
    export APP_NAME="Orion Studio Nightly"
    export BRANDING_LIGHT="#e9aa6a"
    export BRANDING_DARK="#1a5fb4"
    export ICON_FILE="app-icon-nightly"
elif [[ "$channel" == "preview" ]]; then
    export APP_ID="com.orion.OrionStudio.Preview"
    export APP_NAME="Orion Studio Preview"
    export BRANDING_LIGHT="#99c1f1"
    export BRANDING_DARK="#1a5fb4"
    export ICON_FILE="app-icon-preview"
elif [[ "$channel" == "stable" ]]; then
    export APP_ID="com.orion.OrionStudio"
    export APP_NAME="Orion Studio"
    export BRANDING_LIGHT="#99c1f1"
    export BRANDING_DARK="#1a5fb4"
    export ICON_FILE="app-icon"
else
    echo "Invalid channel: '$channel'"
    exit 1
fi

envsubst < "crates/zed/resources/flatpak/manifest-template.json" > "$APP_ID.json"
build_dir="target/flatpak/$APP_ID/build"
mkdir -p "$(dirname "$build_dir")"
flatpak-builder --user --install --force-clean "$build_dir" "$APP_ID.json"
flatpak build-bundle ~/.local/share/flatpak/repo "target/release/$APP_ID.flatpak" "$APP_ID"
echo "Created 'target/release/$APP_ID.flatpak'"
