#!/usr/bin/env bash

set -euo pipefail

gitleaks_version=8.30.1
gitleaks_release_base="https://github.com/gitleaks/gitleaks/releases/download/v${gitleaks_version}"
operating_system=$(uname -s)
architecture=$(uname -m)

case "${operating_system}/${architecture}" in
    Darwin/arm64)
        archive_name="gitleaks_${gitleaks_version}_darwin_arm64.tar.gz"
        expected_sha256="b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5"
        ;;
    Darwin/x86_64)
        archive_name="gitleaks_${gitleaks_version}_darwin_x64.tar.gz"
        expected_sha256="dfe101a4db2255fc85120ac7f3d25e4342c3c20cf749f2c20a18081af1952709"
        ;;
    Linux/aarch64|Linux/arm64)
        archive_name="gitleaks_${gitleaks_version}_linux_arm64.tar.gz"
        expected_sha256="e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080"
        ;;
    Linux/x86_64)
        archive_name="gitleaks_${gitleaks_version}_linux_x64.tar.gz"
        expected_sha256="551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb"
        ;;
    *)
        printf 'error: unsupported platform for pinned gitleaks: %s/%s\n' \
            "${operating_system}" "${architecture}" >&2
        exit 1
        ;;
esac

command -v curl >/dev/null 2>&1 || { echo 'error: curl is required' >&2; exit 1; }
command -v git >/dev/null 2>&1 || { echo 'error: git is required' >&2; exit 1; }
command -v tar >/dev/null 2>&1 || { echo 'error: tar is required' >&2; exit 1; }

repository_root=$(git rev-parse --show-toplevel)
temporary_base=${TMPDIR:-/tmp}
temporary_base=${temporary_base%/}
temporary_directory=$(mktemp -d "${temporary_base}/orion-gitleaks.XXXXXX")

cleanup() {
    local status=$?

    trap - EXIT
    case "${temporary_directory}" in
        "${temporary_base}"/orion-gitleaks.*)
            rm -rf -- "${temporary_directory}"
            ;;
        *)
            printf 'error: refusing to remove unexpected temporary path %s\n' \
                "${temporary_directory}" >&2
            status=1
            ;;
    esac
    exit "${status}"
}
trap cleanup EXIT

sha256_file() {
    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    elif command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    else
        echo 'error: shasum or sha256sum is required' >&2
        return 1
    fi
}

cache_base=${ORION_STUDIO_TOOL_CACHE_DIR:-${XDG_CACHE_HOME:-${HOME}/.cache}/orion-studio/tools}
archive_cache_directory="${cache_base}/gitleaks/${gitleaks_version}"
cached_archive="${archive_cache_directory}/${archive_name}"

if [[ ! -f "${cached_archive}" ]]; then
    downloaded_archive="${temporary_directory}/${archive_name}"
    curl --fail --location --proto '=https' --tlsv1.2 \
        --output "${downloaded_archive}" \
        "${gitleaks_release_base}/${archive_name}"
    actual_sha256=$(sha256_file "${downloaded_archive}")
    [[ "${actual_sha256}" == "${expected_sha256}" ]] || {
        printf 'error: downloaded gitleaks archive checksum mismatch: expected %s, got %s\n' \
            "${expected_sha256}" "${actual_sha256}" >&2
        exit 1
    }
    mkdir -p "${archive_cache_directory}"
    mv "${downloaded_archive}" "${cached_archive}"
fi

actual_sha256=$(sha256_file "${cached_archive}")
[[ "${actual_sha256}" == "${expected_sha256}" ]] || {
    printf 'error: cached gitleaks archive checksum mismatch at %s\n' "${cached_archive}" >&2
    exit 1
}

tar -xzf "${cached_archive}" -C "${temporary_directory}" gitleaks
gitleaks_binary="${temporary_directory}/gitleaks"
[[ -x "${gitleaks_binary}" ]] || {
    echo 'error: verified gitleaks archive did not contain an executable' >&2
    exit 1
}
[[ $("${gitleaks_binary}" version) == "${gitleaks_version}" ]] || {
    echo 'error: extracted gitleaks version does not match the pinned release' >&2
    exit 1
}

cd "${repository_root}"
"${gitleaks_binary}" git --redact --no-banner --no-color --verbose .
