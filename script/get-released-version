#!/usr/bin/env bash

set -euo pipefail

channel="${1:-}"
case $channel in
  stable)
    ;;
  preview)
    ;;
  nightly)
    ;;
  *)
    echo "this must be run on either of stable|preview|nightly release branches" >&2
    exit 1
    ;;
esac

release_api_url="${ORION_STUDIO_RELEASE_API_URL:-https://cloud.orion.dev}"
curl --fail --silent --show-error \
  "${release_api_url%/}/releases/$channel/latest/asset?asset=orion-studio&os=macos&arch=aarch64" \
  | jq --exit-status --raw-output '.version'
