#!/usr/bin/env bash

set -euo pipefail

if [[ $# != 1 ]]; then
  echo "Usage: $0 <production|staging>" >&2
  exit 1
fi

case "$1" in
  production|staging) ;;
  *)
    echo "Unknown collab deployment environment: $1" >&2
    exit 1
    ;;
esac

echo "Local collab deployment and force-moving release tags are disabled." >&2
echo "Request the $1 deployment through the protected Orion Studio GitHub workflow and environment approval." >&2
exit 1
